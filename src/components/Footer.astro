---
import { company } from '../content/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="row">
    <div>
      <p class="name">{company.nameJa}</p>
      <p class="addr">{company.address}</p>
    </div>
    <a class="privacy" href={`${base}/privacy/`}>プライバシーポリシー</a>
  </div>
  <p class="copy">{company.copyright}</p>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 56px var(--gutter) 40px;
    font-size: 13px;
    color: var(--text-sub);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .name {
    color: var(--text);
    font-size: 14px;
    letter-spacing: 0.1em;
  }
  .privacy:hover {
    color: var(--text);
  }
  .copy {
    margin-top: 40px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
</style>
